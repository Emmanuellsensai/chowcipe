VITE_PEXELS_API_KEY=your_pexels_api_key_here

# Dev only. Read by the browser so `npm run dev` can call Gemini directly.
# Anything VITE_-prefixed is readable by anyone who loads the page.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Server-side only. Used by the /api/recipes serverless proxy in production.
# Set this one (not the VITE_ variant) in the Vercel dashboard.
GEMINI_API_KEY=your_gemini_api_key_here
